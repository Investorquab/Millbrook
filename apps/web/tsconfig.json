{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@millbrook/shared": ["../../packages/shared/src/index.ts"],
      "@millbrook/economy": ["../../packages/economy/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
