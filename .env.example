# Millbrook environment — copy to .env on the machine that needs it and fill in.
# Never commit a real .env; never paste a key into chat. Empty values here are
# intentional. The simulation (packages/economy, `pnpm sim`) needs NONE of these;
# they are for the server, the chain and the Game Master as those land.

# ── NEAR (testnet) ──────────────────────────────────────────────────────────
# Operator account: parent of every player sub-account, deploys the contract,
# pays gas. Create at https://near-faucet.io and fund from the faucet.
NEAR_NETWORK=testnet
NEAR_OPERATOR_ACCOUNT_ID=
NEAR_OPERATOR_PRIVATE_KEY=
# Deployed game contract id (NEP-245 items + coins + settlement). Also printed
# in the README once deployed.
NEAR_CONTRACT_ID=

# ── NEAR AI Cloud (Game Master reasoning, the Gazette, Foreman messages) ─────
# OpenAI-compatible endpoint. Key from https://cloud.near.ai
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# ── OutLayer (runs the Game Master in an enclave) ───────────────────────────
# Account + payment key from https://app.outlayer.ai
OUTLAYER_API_KEY=

# ── Email (magic-link login) ────────────────────────────────────────────────
# Any transactional email provider.
EMAIL_API_KEY=
EMAIL_FROM=

# ── Real-world feeds (Game Master events) ───────────────────────────────────
# A free weather API; confirm it works from inside OutLayer.
WEATHER_API_KEY=

# ── Server / database ───────────────────────────────────────────────────────
DATABASE_URL=postgres://millbrook:millbrook@localhost:5432/millbrook
PORT=8080
PUBLIC_BASE_URL=http://localhost:5173
