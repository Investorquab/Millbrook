# Millbrook environment — copy to .env on the machine that needs it and fill in.
# Never commit a real .env; never paste a key into chat. Empty values here are
# intentional. The simulation (packages/economy, `pnpm sim`) needs NONE of these;
# they are for the server, the chain and the Game Master as those land.

# ── NEAR (testnet) ──────────────────────────────────────────────────────────
# Operator account: parent of every player sub-account, deploys the contract,
# pays gas. Create at https://near-faucet.io and fund from the faucet.
NEAR_NETWORK=testnet
NEAR_OPERATOR_ACCOUNT_ID=
NEAR_OPERATOR_PRIVATE_KEY=
# Deployed game contract id (NEP-245 items + coins + settlement). Also printed
# in the README once deployed.
NEAR_CONTRACT_ID=

# ── NEAR AI Cloud (Game Master reasoning, the Gazette, Foreman messages) ─────
# OpenAI-compatible endpoint. Key from https://cloud.near.ai
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# ── OutLayer (runs the Game Master in an enclave) ───────────────────────────
# Account + payment key from https://app.outlayer.ai. Project is <owner>/<project>;
# the HTTPS call path is /call/{owner}/{project}. Fallback: the Game Master runs
# on town metrics only and says so. Verify: node scripts/spikes/outlayer.mjs
OUTLAYER_API_KEY=
OUTLAYER_BASE_URL=https://testnet-api.outlayer.ai
OUTLAYER_PROJECT=

# ── Email (magic-link login) ────────────────────────────────────────────────
# Resend by default (key starts with re_). Optional for dev: the server prints
# the magic link to its console if this is empty, so sign-in still works.
# EMAIL_FROM must be a sender Resend will accept: either an address on a domain
# you verified in Resend, or their sandbox sender onboarding@resend.dev (which
# only delivers to your own Resend account email). A plain gmail.com address is
# NOT a valid Resend sender.
# Verify: node scripts/spikes/email.mjs
EMAIL_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ── Real-world feeds (Game Master events) ───────────────────────────────────
# OPTIONAL. The default is Open-Meteo, which needs NO key — leave this empty.
# Only set it if you switch to a keyed provider (e.g. OpenWeatherMap).
# Verify: node scripts/spikes/weather.mjs
WEATHER_API_KEY=

# ── Server / database ───────────────────────────────────────────────────────
DATABASE_URL=postgres://millbrook:millbrook@localhost:5432/millbrook
PORT=8080
# The web origin, used to build magic-link URLs. In production set this to your
# domain, e.g. https://yourdomain.com (dev: the Vite origin below).
PUBLIC_BASE_URL=http://localhost:5173
