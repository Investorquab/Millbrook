{
  "name": "millbrook",
  "version": "0.0.0",
  "private": true,
  "description": "Millbrook — a browser game with a closed economy settled on NEAR. A town of 30 residents who are both your workers and your only customers.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sim": "pnpm --filter @millbrook/economy sim",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @millbrook/web dev",
    "e2e": "playwright test",
    "contract:build": "cargo build --release --target wasm32-unknown-unknown -p millbrook-contract --manifest-path contracts/millbrook/Cargo.toml",
    "contract:test": "cargo test -p millbrook-ledger --manifest-path contracts/millbrook/Cargo.toml",
    "contract:deploy:testnet": "tsx scripts/deploy-contract.ts"
  },
  "devDependencies": {
    "@millbrook/economy": "workspace:*",
    "@millbrook/game-master": "workspace:*",
    "@millbrook/shared": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "near-api-js": "^5.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
